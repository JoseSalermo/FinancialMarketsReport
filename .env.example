# Vault connection bootstrap. Values belong in a local .env file or Docker secret, not Git.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/financial-market-report

# Optional container user override for bind-mounted NAS folders.
FMR_UID=1000
FMR_GID=1000

# Optional local-development fallback secret names. Leave values blank in Git.
NEWS_API_KEY=
FMP_API_KEY=
YHF_API_KEY=
BEN_API_KEY=
GMAIL_APP_PASSWORD=
SENDER_EMAIL=
TARGET_EMAIL=
